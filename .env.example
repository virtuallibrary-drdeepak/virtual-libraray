# MongoDB Connection
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/virtual-library

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/virtual-library?retryWrites=true&w=majority

# Environment
NODE_ENV=development

# Optional: Custom upload directory (defaults to /tmp/uploads)
# UPLOAD_DIR=/path/to/custom/uploads

# Razorpay
# Get Key ID + Key Secret from: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use rzp_test_* for local/dev, rzp_live_* for production.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook
# Configure at: https://dashboard.razorpay.com/app/webhooks
# Webhook URL: https://YOUR_DOMAIN/api/payment/webhook
# Active events: payment.authorized, payment.captured, payment.failed, order.paid
# Generate a strong secret with:  openssl rand -hex 32
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
