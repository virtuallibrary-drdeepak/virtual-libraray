# MongoDB Connection
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/virtual-library

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/virtual-library?retryWrites=true&w=majority

# Environment
NODE_ENV=development

# Optional: Custom upload directory (defaults to /tmp/uploads)
# UPLOAD_DIR=/path/to/custom/uploads

# Meta Pixel diagnostics
# Local development writes by default to logs/meta-pixel.log.
# In production, enable explicitly and optionally override the file path.
META_PIXEL_FILE_LOGGING_ENABLED=true
META_PIXEL_LOG_FILE=/tmp/meta-pixel.log
